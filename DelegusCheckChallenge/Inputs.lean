import Lean.Data.Json
import DelegusCheckChallenge.Basic

namespace DelegusCheck

open Lean (Json JsonNumber)

/-! ## JSON access

Small total helpers over `Lean.Json`. All protocol rules below are written
with these, so a statement about a field is a statement about `field?`. -/

/-- The members of an object, in order (none for a non-object). -/
def members (j : Json) : List (String × Json) :=
  match j with
  | .obj kv => kv.toList
  | _ => []

/-- The member `k` of an object, if `j` is an object that has it. -/
def field? (j : Json) (k : String) : Option Json :=
  ((members j).find? (fun (m : String × Json) => m.1 == k)).map (fun (m : String × Json) => m.2)

/-- The member names of an object (none for a non-object). -/
def keysOf (j : Json) : List String := (members j).map (fun (m : String × Json) => m.1)

def isObj (j : Json) : Bool :=
  match j with
  | .obj _ => true
  | _ => false

def str? (j : Json) : Option String :=
  match j with
  | .str s => some s
  | _ => none

def arr? (j : Json) : Option (List Json) :=
  match j with
  | .arr a => some a.toList
  | _ => none

/-- A string member. -/
def fieldStr? (j : Json) (k : String) : Option String := (field? j k).bind str?

/-- The member is the string `s`. -/
def fieldIs (j : Json) (k s : String) : Bool := fieldStr? j k == some s

/-- The member is present. -/
def has (j : Json) (k : String) : Bool := (field? j k).isSome

/-- `j` is an object whose member names are exactly `ks` (no more, no fewer). -/
def exactKeys (j : Json) (ks : List String) : Bool :=
  isObj j && (keysOf j).length == ks.length && ks.all (has j) && (keysOf j).all (ks.contains ·)

/-- `j` is an object whose member names are all in `ks`. -/
def onlyKeys (j : Json) (ks : List String) : Bool :=
  isObj j && (keysOf j).all (ks.contains ·)

/-- `j` is an array of exactly these strings, in this order. -/
def isStrArray (j : Json) (ss : List String) : Bool :=
  match arr? j with
  | some xs => xs.map str? == ss.map some
  | none => false

/-- The integer value of a JSON number, if it is an integer (`1.0` counts, as
    in ECMAScript). -/
def int? (j : Json) : Option Int :=
  match j with
  | .num n =>
    let d : Int := (10 : Int) ^ n.exponent
    if n.mantissa % d == 0 then some (n.mantissa / d) else none
  | _ => none

def maxSafe : Int := 2 ^ 53 - 1

/-- A safe integer (|v| ≤ 2^53 − 1), the engine's `Number.isSafeInteger`. -/
def safeInt? (j : Json) : Option Int :=
  match int? j with
  | some v => if -maxSafe ≤ v ∧ v ≤ maxSafe then some v else none
  | none => none

/-- JSON number `j` equals the rational `num / den` exactly. -/
def numEqFrac (j : Json) (num : Int) (den : Nat) : Bool :=
  match j with
  | .num n => n.mantissa * den == num * (10 : Int) ^ n.exponent
  | _ => false

/-! ## Inputs (§0 constraint 2, §5.2, §5.3) -/

abbrev Did := String
/-- A raw Ed25519 public key, as 64 lowercase hex characters. -/
abbrev PubKey := String

/-- `now`, milliseconds since the epoch; recorded as `evaluated_at`. -/
structure Clock where
  nowMs : Int
  deriving DecidableEq, Repr

structure Request where
  /-- Compact JWS as received. -/
  grant : String
  /-- Compact JWS as received. -/
  proof : String
  /-- The Action exactly as the RP submitted it. -/
  action : Json
  /-- The RP DID the API key resolved to. -/
  rp : Did
  /-- RP-configured Proof window in seconds, 1..300 (§4.2). -/
  windowS : Nat

/-- What T1–T3 and P2 see: one issuer-registry answer (§5.3, §2.1). -/
inductive IssuerLookup
  | unavailable
  | unknown
  | registered (domainVerified : Bool) (compromisedKids : List String) (didDocument : String)

/-- What P6 sees, after the `status_ver` read (§7). -/
inductive StatusLookup
  | unavailable
  | snapshot (credential : String)
  deriving DecidableEq

/-- The service state the evaluation reads, as answers to the two read
    operations of the hot path (§5.5): the issuer registry by Principal DID
    (asked once after P1) and the status-list credential by
    `statusListCredential` URL (asked once before P6, after the `status_ver`
    read of §7). -/
structure Snapshots where
  issuer : Did → IssuerLookup
  status : String → StatusLookup

/-- What the protocol layer may depend on from an issuer answer: whether the
    Principal is registered and, if so, its DID document snapshot. Domain
    verification and compromised keys are trust data (T2, T3). -/
inductive IssuerView
  | unavailable
  | unknown
  | registered (didDocument : String)
  deriving DecidableEq

def IssuerLookup.view : IssuerLookup → IssuerView
  | .unavailable => .unavailable
  | .unknown => .unknown
  | .registered _ _ doc => .registered doc

structure TrustConfig where
  /-- The Delegus root DID (`did:web:delegus.ai` in production). -/
  serviceDid : Did
  /-- Delegus status-list signing keys by `kid`. -/
  statusKeys : List (String × PubKey)

/-- The answer of the replay store's `SET NX` (§5.3). -/
inductive ReplayAnswer
  | ok
  | replayed
  | unavailable
  deriving DecidableEq, Repr

/-! ## Primitives (plan §1.6)

Cryptography, hashing and decoding are parameters. (Since Phase 6 the `htu`
canonical form and RFC 8785 JCS are written in Lean: `Htu.lean`,
`Jcs.lean`.) Every theorem
quantifies over every `Prims`; assumptions about them (unforgeable
signatures, collision-free hashing) are hypotheses on the theorems that use
them, never `axiom`s. -/

/-- A decoded compact JWS. -/
structure Jws where
  header : Json
  payload : Json
  /-- ASCII `<b64 header>.<b64 payload>`, the JWS signing input. -/
  signingInput : String
  /-- The signature segment as received. -/
  signature : String

structure Prims where
  /-- Strict compact JWS decoding (RFC 7515): three base64url segments, a
      64-byte signature, header and payload JSON objects; duplicate members
      or unsafe integers → `none`. -/
  decodeJws : String → Option Jws
  /-- Strict JSON parsing of a DID document's bytes. -/
  parseJson : String → Option Json
  /-- `did:key` Ed25519 DID → raw public key (syntax, base58btc multibase,
      0xed01 prefix, canonical encoding). Key safety is `keyOk`. -/
  didKeyPub : String → Option PubKey
  /-- `publicKeyMultibase` (base58btc, 0xed01) → raw public key. -/
  multibasePub : String → Option PubKey
  /-- Erratum 3: the key is a canonical encoding and not one of the eight
      points of small order. -/
  keyOk : PubKey → Bool
  /-- Ed25519 verification of `signature` over `signingInput` (EdDSA only). -/
  sigOk : PubKey → String → String → Bool
  /-- `sha256:<64 lowercase hex>` of the UTF-8 bytes (§6.3). -/
  sha256 : String → String
  /-- RFC 3339 UTC → milliseconds since the epoch. -/
  rfc3339 : String → Option Int
  /-- Bitstring Status List `encodedList` (after the multibase `u`):
      base64url, then GZIP. -/
  decodeList : String → Option ByteArray

end DelegusCheck
