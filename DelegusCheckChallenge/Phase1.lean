/-- Check `k` is its own rule when every prerequisite is `true`, and
    `skipped` otherwise. -/
theorem staged_get (e : Env) (k : Check) :
    (staged e).get k =
      if (enginePrereq k).all (fun p => (staged e).get p == .pass) then base e k else .skipped := sorry
