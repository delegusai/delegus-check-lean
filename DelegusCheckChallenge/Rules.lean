import DelegusCheckChallenge.Grant

namespace DelegusCheck

open Lean (Json)

/-! ## P2: the DID document snapshot (§2.1) -/

def didDocumentMaxKeys : Nat := 5

/-- The Ed25519 key `kid` names in the DID document snapshot: the document
    is for `issuer`, has 1–5 verification methods, exactly one with this
    `id`, of type `Multikey`, controlled by `issuer`, whose key decodes and
    is safe (erratum 3). `none` otherwise. -/
def findKey (π : Prims) (doc : String) (issuer kid : String) : Option PubKey := do
  let d ← π.parseJson doc
  req (isObj d)
  req (fieldIs d "id" issuer)
  let vms ← (field? d "verificationMethod").bind arr?
  req (0 < vms.length && vms.length ≤ didDocumentMaxKeys)
  let ms := vms.filter (fun m => isObj m && fieldIs m "id" kid)
  match ms with
  | [vm] =>
    req (fieldIs vm "type" "Multikey")
    req (fieldIs vm "controller" issuer)
    let k ← (fieldStr? vm "publicKeyMultibase").bind π.multibasePub
    req (π.keyOk k)                                        -- erratum 3
    some k
  | _ => none

/-! ## P6: the status-list credential (§5.2, §7)

Signed by Delegus with a trusted status-list key, a W3C Bitstring Status
List credential for exactly the Grant's `statusListCredential`, valid at
`now`, and the bit at `statusListIndex` is 0. -/

def statusContext : List String := ["https://www.w3.org/ns/credentials/v2"]
def statusType : List String := ["VerifiableCredential", "BitstringStatusListCredential"]

/-- Bit `i` of a bitstring, most significant bit first. -/
def bitAt (bits : ByteArray) (i : Nat) : Option Bool :=
  if i < bits.size * 8 then
    some (((bits.get! (i / 8)).toNat >>> (7 - i % 8)) % 2 == 1)
  else none

/-- The trusted status-list key with this `kid`. -/
def statusKey (tc : TrustConfig) (kid : String) : Option PubKey :=
  (tc.statusKeys.find? (fun (kv : String × PubKey) => kv.1 == kid)).map (fun (kv : String × PubKey) => kv.2)

/-- An optional RFC 3339 member: absent is `none`; present must parse. -/
def optTime (π : Prims) : Option Json → Option (Option Int)
  | none => some none
  | some v => ((str? v).bind π.rfc3339).map some

/-- The Grant's revocation bit, read from a usable status credential: `some
    false` (not revoked), `some true` (revoked), or `none` when the
    credential is unusable (not decodable, not signed by a trusted Delegus
    status-list key, not for this URL, outside its own validity, malformed,
    or the index outside the list). The credential's validity window is read
    with the same `now` as every other check (one clock, owner-confirmed
    22 Nov 2026). -/
def statusBit (π : Prims) (tc : TrustConfig) (nowMs : Int) (credential url index : String) : Option Bool :=
  do
    let j ← π.decodeJws credential
    let h := j.header
    let p := j.payload
    req (exactKeys h ["alg", "typ", "kid"] && fieldIs h "alg" "EdDSA" && fieldIs h "typ" "vc+jwt")
    let kid ← fieldStr? h "kid"
    let kidDid ← didWebUrlDid kid
    req (kidDid == tc.serviceDid)
    let key ← statusKey tc kid
    req (π.sigOk key j.signingInput j.signature)
    req (onlyKeys p ["@context", "type", "id", "issuer", "validFrom", "validUntil",
                      "credentialSubject", "iss", "jti", "nbf", "exp"])
    req (((field? p "@context").map (isStrArray · statusContext)).getD false)
    req (((field? p "type").map (isStrArray · statusType)).getD false)
    req (fieldIs p "id" url)
    req (fieldIs p "issuer" tc.serviceDid)
    let vf ← (fieldStr? p "validFrom").bind π.rfc3339
    let vu ← optTime π (field? p "validUntil")
    req (match field? p "iss" with | none => true | some _ => fieldIs p "iss" tc.serviceDid)
    req (match field? p "jti" with | none => true | some _ => fieldIs p "jti" url)
    req (match field? p "nbf" with | none => true | some v => numEqFrac v vf 1000)
    req (match field? p "exp" with
      | none => true
      | some v => match vu with | some u => numEqFrac v u 1000 | none => false)
    let cs ← field? p "credentialSubject"
    req (onlyKeys cs ["id", "type", "statusPurpose", "encodedList"])
    req (fieldIs cs "type" "BitstringStatusList")
    req (fieldIs cs "statusPurpose" "revocation")
    let enc ← fieldStr? cs "encodedList"
    req (enc.startsWith "u")
    let bits ← π.decodeList (sdrop enc 1)
    req (decide (vf ≤ nowMs))
    req (match vu with | some u => decide (nowMs < u) | none => true)
    req (isDecimal index)
    bitAt bits (decimalValue index)

/-- The credential is usable and shows the Grant not revoked at `now`. -/
def statusOk (π : Prims) (tc : TrustConfig) (nowMs : Int) (credential url index : String) : Bool :=
  statusBit π tc nowMs credential url index == some false

/-! ## P7: audience (§3.2 row 13) -/

def audienceOk (g : GrantF) (rp : Did) : Bool :=
  match g.audience with
  | none => true
  | some auds => auds.contains rp

/-! ## P15: the Action (§5.1, §4.3) -/

inductive Action
  | purchase (resource : String) (amount : Int) (currency : String)
  | apiCall (method : String) (resource : String)

def Action.type : Action → String
  | .purchase .. => "commerce:purchase"
  | .apiCall .. => "api:call"

def Action.resource : Action → String
  | .purchase r _ _ => r
  | .apiCall _ r => r

/-- The fields each action type carries (§4.3); anything else is
    `ACTION_MALFORMED` (§5.1). -/
def actionFields : String → Option (List String)
  | "commerce:purchase" => some ["type", "resource", "amount", "currency"]
  | "api:call" => some ["type", "method", "resource"]
  | _ => none

/-- P15: the Action is valid for its `type`. -/
def validateAction (a : Json) : Option Action := do
  let t ← fieldStr? a "type"
  let fs ← actionFields t
  req (exactKeys a fs)
  if t == "commerce:purchase" then
    let r ← fieldStr? a "resource"
    req (!r.isEmpty)
    let amount ← (field? a "amount").bind safeInt?
    req (0 ≤ amount)
    let cur ← fieldStr? a "currency"
    req (isCurrency cur)
    some (.purchase r amount cur)
  else
    let m ← fieldStr? a "method"
    req (isHttpMethod m)
    let r ← fieldStr? a "resource"
    req (isAbsoluteHttpUri r)
    some (.apiCall m r)

/-! ## P16–P20: authorization (§3.3)

The candidates are the Capabilities whose `action` is `action.type`; P16 to
P20 each narrow them, and a check is false when none remain. The first
survivor of P20 is the receipt `authority`. -/

/-- No constraint key outside what this version evaluates (P17). -/
def allKeysKnown (c : Capability) : Bool :=
  c.constraints.all (fun kv => (knownConstraintKeys c.action).contains kv.1)

def currencyMatches (c : Capability) (cur : String) : Bool :=
  (constraintVal? c "currency").bind str? == some cur

def amountWithin (c : Capability) (amount : Int) : Bool :=
  match (constraintVal? c "maxAmount").bind safeInt? with
  | some m => decide (amount ≤ m)
  | none => false

def methodAllowed (c : Capability) (m : String) : Bool :=
  match (constraintVal? c "methods").bind arr? with
  | some ms => ms.any (str? · == some m)
  | none => false

def resourceMatches (c : Capability) (r : String) : Bool :=
  c.resources.any (globMatch · r)

/-- The P20 filter: for `api:call` the method is allowed, and a resource
    pattern matches. -/
def p20Keep (a : Action) (c : Capability) : Bool :=
  (match a with
   | .apiCall m _ => methodAllowed c m
   | .purchase .. => true) && resourceMatches c a.resource

structure Authorization where
  p16 : Outcome
  p17 : Outcome
  p18 : Outcome
  p19 : Outcome
  p20 : Outcome
  /-- The authorizing Capability: the first survivor of P20. -/
  matched : Option Capability

def nonempty {α} (l : List α) (r : Reason) : Outcome := if l.isEmpty then .fail r else .pass

def authorize (caps : List Capability) (a : Action) : Authorization :=
  let c16 := caps.filter (·.action == a.type)
  if c16.isEmpty then
    ⟨.fail .ACTION_NOT_AUTHORIZED, .skipped, .skipped, .skipped, .skipped, none⟩
  else if !c16.all allKeysKnown then
    ⟨.pass, .fail .UNKNOWN_CONSTRAINT, .skipped, .skipped, .skipped, none⟩
  else
    let (c18, c19) := match a with
      | .purchase _ amount cur =>
        let c18 := c16.filter (currencyMatches · cur)
        (c18, c18.filter (amountWithin · amount))
      | .apiCall .. => (c16, c16)
    if c18.isEmpty then
      ⟨.pass, .pass, .fail .CURRENCY_NOT_AUTHORIZED, .skipped, .skipped, none⟩
    else if c19.isEmpty then
      ⟨.pass, .pass, .pass, .fail .AMOUNT_EXCEEDS_AUTHORITY, .skipped, none⟩
    else
      let c20 := c19.filter (p20Keep a)
      ⟨.pass, .pass, .pass, .pass, nonempty c20 .RESOURCE_NOT_AUTHORIZED, c20.head?⟩

end DelegusCheck
