import DelegusCheckChallenge.Inputs

namespace DelegusCheck

/-- Drop the first `n` characters (a `String`, not a slice). -/
def sdrop (s : String) (n : Nat) : String := String.ofList (s.toList.drop n)

def isLowerAlnum (c : Char) : Bool := ('a' ≤ c && c ≤ 'z') || ('0' ≤ c && c ≤ '9')
def isAlnum (c : Char) : Bool := ('a' ≤ c && c ≤ 'z') || ('A' ≤ c && c ≤ 'Z') || ('0' ≤ c && c ≤ '9')
def isUpper (c : Char) : Bool := 'A' ≤ c && c ≤ 'Z'
def isDigit (c : Char) : Bool := '0' ≤ c && c ≤ '9'
def isLowerHex (c : Char) : Bool := isDigit c || ('a' ≤ c && c ≤ 'f')

/-- A DNS label of a `did:web` host: 1–63 of `[a-z0-9-]`, starting and
    ending with `[a-z0-9]`. -/
def isHostLabel (l : String) : Bool :=
  let cs := l.toList
  0 < cs.length && cs.length ≤ 63 &&
  cs.all (fun c => isLowerAlnum c || c == '-') &&
  (cs.head?.map isLowerAlnum).getD false && (cs.getLast?.map isLowerAlnum).getD false

def isPathSegment (s : String) : Bool :=
  !s.isEmpty && s.toList.all (fun c => isAlnum c || c == '.' || c == '_' || c == '-')

/-- `did:web` syntax (§2.1, §2.3): lowercase DNS name, an optional
    `%3A`-encoded port of 1–5 digits, optional `:`-separated path segments. -/
def isDidWeb (s : String) : Bool :=
  if s.startsWith "did:web:" then
    match (sdrop s 8).splitOn ":" with
    | [] => false
    | hostPort :: segs =>
      let hostOk (h : String) := (h.splitOn ".").all isHostLabel
      let portOk := match hostPort.splitOn "%3A" with
        | [h] => hostOk h
        | [h, p] => hostOk h && 0 < p.length && p.length ≤ 5 && p.toList.all isDigit
        | _ => false
      portOk && segs.all isPathSegment
  else false

def isFragmentChar (c : Char) : Bool := isAlnum c || c == '.' || c == '_' || c == '~' || c == '-'

/-- Split a DID URL `<did>#<fragment>` at the first `#`. -/
def parseDidUrl (s : String) : Option (String × String) :=
  match s.splitOn "#" with
  | did :: frag :: rest =>
    let fragment := String.intercalate "#" (frag :: rest)
    if !fragment.isEmpty && fragment.toList.all isFragmentChar then some (did, fragment) else none
  | _ => none

/-- A `did:web` DID URL; returns the DID. -/
def didWebUrlDid (s : String) : Option String :=
  match parseDidUrl s with
  | some (did, _) => if isDidWeb did then some did else none
  | none => none

/-- The Agent key DID URL for a `did:key` DID (§4.1): `did:key:z6Mk...#z6Mk...`. -/
def agentKidFor (didKey : String) : String := didKey ++ "#" ++ sdrop didKey 8

/-- Crockford base32 as used by ULID (no I, L, O, U). -/
def isUlidChar (c : Char) : Bool :=
  isDigit c || (isUpper c && c != 'I' && c != 'L' && c != 'O' && c != 'U')

def isUlid (s : String) : Bool :=
  match s.toList with
  | c :: rest => ('0' ≤ c && c ≤ '7') && rest.length == 25 && rest.all isUlidChar
  | [] => false

/-- `urn:delegus:grant:<ULID>` (§3.2 row 6). -/
def isGrantId (s : String) : Bool :=
  s.startsWith "urn:delegus:grant:" && isUlid (sdrop s 18)

def isBase64UrlChar (c : Char) : Bool := isAlnum c || c == '-' || c == '_'

/-- §4.2 `jti`: 22–64 ASCII characters. The engine, and so the model,
    accepts the base64url alphabet only (the SHOULD encoding, the only
    checkable proxy for ≥ 128 random bits). -/
def isJti (s : String) : Bool :=
  22 ≤ s.length && s.length ≤ 64 && s.toList.all isBase64UrlChar

/-- Uppercase HTTP method, 1–32 letters. -/
def isHttpMethod (s : String) : Bool :=
  0 < s.length && s.length ≤ 32 && s.toList.all isUpper

/-- ISO 4217 shape: three uppercase letters. -/
def isCurrency (s : String) : Bool := s.length == 3 && s.toList.all isUpper

/-- `sha256:<64 lowercase hex>` (§6.3). -/
def isSha256Ref (s : String) : Bool :=
  s.startsWith "sha256:" && (sdrop s 7).length == 64 && (sdrop s 7).toList.all isLowerHex

/-- Decimal without leading zeros. -/
def isDecimal (s : String) : Bool :=
  match s.toList with
  | ['0'] => true
  | c :: rest => ('1' ≤ c && c ≤ '9') && rest.all isDigit
  | [] => false

def decimalValue (s : String) : Nat :=
  s.toList.foldl (fun acc c => acc * 10 + (c.toNat - '0'.toNat)) 0

/-- `http(s)://` followed by one or more printable ASCII characters. -/
def isAbsoluteHttpUri (s : String) : Bool :=
  let rest := if s.startsWith "https://" then some (sdrop s 8)
    else if s.startsWith "http://" then some (sdrop s 7) else none
  match rest with
  | some r => !r.isEmpty && r.toList.all (fun c => '!' ≤ c && c ≤ '~')
  | none => false

/-! ## Resource globs (§3.3): `*` is any run of characters except `/`, `**` is
any run of characters; everything else is literal; whole-string match. -/

inductive GlobTok
  | lit (c : Char)
  | star
  | dstar

def globTokens : List Char → List GlobTok
  | '*' :: '*' :: r => .dstar :: globTokens r
  | '*' :: r => .star :: globTokens r
  | c :: r => .lit c :: globTokens r
  | [] => []

def globMatchTok : List GlobTok → List Char → Bool
  | [], v => v.isEmpty
  | .lit c :: ps, v =>
    match v with
    | c' :: vs => c == c' && globMatchTok ps vs
    | [] => false
  | .star :: ps, v =>
    globMatchTok ps v ||
    (match v with
     | c :: vs => c != '/' && globMatchTok (.star :: ps) vs
     | [] => false)
  | .dstar :: ps, v =>
    globMatchTok ps v ||
    (match v with
     | _ :: vs => globMatchTok (.dstar :: ps) vs
     | [] => false)
termination_by ps v => ps.length + v.length

def globMatch (pattern value : String) : Bool :=
  globMatchTok (globTokens pattern.toList) value.toList

end DelegusCheck
